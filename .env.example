# Supabase — copy to .env.local and fill in from your project's API settings.

# Public (safe for the browser) — project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the client. Used for admin actions such as
# inviting users. Keep it out of NEXT_PUBLIC_* and out of client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where invite / password-reset links send the user back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
