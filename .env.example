# ─────────────────────────────────────────────────────────────────────────────
# Azure Creative Platform — environment template
# Copy to .env.local and fill in. NEVER commit real values.
# Model/provider keys are SERVER-SIDE ONLY. Anything a browser can read must be
# safe to be public (per CLAUDE.md: keys never reach client code).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — the NEXT_PUBLIC_ values are safe for the browser (anon key is
# gated by Row Level Security). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — reasoning engine: extraction, strategy, prompt
# engineering, QA. Server-only.
ANTHROPIC_API_KEY=

# Higgsfield — first image-generation provider. Format is "KEY_ID:KEY_SECRET".
# Server-only. Obtain from the Higgsfield API dashboard.
HF_CREDENTIALS=

# Which image provider a new project uses by default.
DEFAULT_IMAGE_PROVIDER=higgsfield

# App URL, used for signed callbacks/webhooks and worker kicks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret guarding the background worker endpoint (/api/worker/run).
# Set to any long random string; a cron job / worker kicks it with this secret.
WORKER_SECRET=
