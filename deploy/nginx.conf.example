# Reverse proxy for the Azure Creative Platform.
# Copy to /etc/nginx/sites-available/azure-platform, edit server_name, then:
#   ln -s /etc/nginx/sites-available/azure-platform /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d your-domain.com     # adds HTTPS + auto-renewal
#
# certbot rewrites this block to add the TLS listener and redirect :80 → :443.

server {
    listen 80;
    server_name your-domain.com;

    # Brief/tender packages can be tens of MB — allow large uploads.
    client_max_body_size 60M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Image generation can take minutes; don't cut long worker requests off.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
